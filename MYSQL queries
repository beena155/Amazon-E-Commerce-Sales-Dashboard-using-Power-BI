create database amazonsales;
use amazonsales;
create table sales (`index` int,
                    `order id` varchar(100),
                     `date` varchar(20),
                     `status` varchar(50),
                     `fullfilment` varchar(20),
                     `sales channel` varchar(20),
                     `ship-service-level` varchar(20),
                     `style` varchar(20),
                     `SKU` text,
                     `category` varchar(20),
                     `size` varchar(20),
                     `ASIN` varchar(20),
                     `courier status` varchar(20),
                     `qty` int,
                     `currency` varchar(10),
                     `amount` int,
                     `ship-city` varchar(300),
                     `ship-state` varchar(300),
                     `ship-postal-code` varchar(300),
                     `ship-county` varchar(300),
                     `promotion-ids` text,
                     `BSB` varchar(10),
                     `final-fullfilled-by` varchar(20)
                     );
drop table sales;
select * from sales;                    
alter table sales modify column `promotion-ids` text;					
LOAD DATA INFILE 'C:/ProgramData/MySQL/MySQL Server 8.0/Uploads/sales.csv'
